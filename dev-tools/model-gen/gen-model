#!/usr/bin/env python3
"""
gen-model: generate Kotlin data classes from sample JSON files.
Field types are inferred from the sample values.

Response chain (response.json):  ResponseX -> XEntity -> X
Request chain  (request.json):   X(Spec) -> XSpecEntity -> RequestX
                                 (model)     (entity)      (remote)

Workflow:
  1. edit response.json (and request.json if the endpoint takes a request)  <- don't forget!
  2. gen-model Testing                  # response chain only
     gen-model Testing --with-request   # + request chain
     gen-model Testing --with-request --no-from-mapper   # only RequestTesting, no mappers
     gen-model Testing --dry-run        # preview, write nothing
"""
import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

KEYWORDS = {
    "class", "val", "var", "fun", "object", "in", "is", "as", "when", "if", "else",
    "for", "while", "return", "interface", "typealias", "package", "this", "super",
    "null", "true", "false", "try", "throw", "do", "break", "continue",
}
MODEL_DEFAULTS = {"Int": "0", "Long": "0L", "Double": "0.0", "Boolean": "false"}
SKIP_DIRS = {"build", ".git", ".gradle", ".idea", "node_modules"}

# serialization -> (field import, field annotation, optional (class import, class annotation))
SERIAL = {
    "gson": ("com.google.gson.annotations.SerializedName", 'SerializedName("{k}")', None),
    "moshi": ("com.squareup.moshi.Json", 'Json(name = "{k}")', None),
    "kotlinx": ("kotlinx.serialization.SerialName", 'SerialName("{k}")',
                ("kotlinx.serialization.Serializable", "Serializable")),
}

# layer -> config path key (where the file goes / which package it gets)
PATH_KEY = {"response": "response", "request": "request", "entity": "entity",
            "specEntity": "entity", "model": "model", "spec": "model"}
DEFAULT_LAYERS = ("model", "spec")          # non-null fields with default values, @Parcelize
NEXT_LAYER = {"response": "entity", "entity": "model", "request": "specEntity", "specEntity": "spec"}

WARNINGS = []


# ------------------------------------------------------------- inference ----

@dataclass
class Type:
    kind: str                      # prim | list | obj
    name: str = ""
    inner: "Type | None" = None
    cls: "ClassDef | None" = None


@dataclass
class Field:
    key: str
    name: str
    type: Type


@dataclass
class ClassDef:
    name: str
    fields: list = field(default_factory=list)


def pascal(s):
    return "".join(p[:1].upper() + p[1:] for p in re.split(r"[_\-\s]+", s) if p)


def camel(s):
    p = pascal(s)
    return p[:1].lower() + p[1:]


def singular(s):
    if s.endswith("ies") and len(s) > 3:
        return s[:-3] + "y"
    if s.endswith("s") and not s.endswith(("ss", "us", "is")) and len(s) > 1:
        return s[:-1]
    return s


def ident(name):
    return f"`{name}`" if name in KEYWORDS else name


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def infer_fields(dicts):
    """Merge several JSON objects (same shape) into a field list."""
    keys = []
    for d in dicts:
        for k in d:
            if k not in keys:
                keys.append(k)
    return [Field(k, camel(k), infer([d[k] for d in dicts if k in d], k)) for k in keys]


def infer(samples, key, in_list=False):
    samples = [s for s in samples if s is not None]
    if not samples:
        WARNINGS.append(f"'{key}' is null/missing in the sample, defaulted to String")
        return Type("prim", "String")
    if all(isinstance(s, dict) for s in samples):
        name = pascal(singular(key) if in_list else key)
        return Type("obj", cls=ClassDef(name, infer_fields(samples)))
    if all(isinstance(s, list) for s in samples):
        items = [i for s in samples for i in s]
        if not items:
            WARNINGS.append(f"'{key}' is an empty array in the sample, defaulted to List<String>")
            return Type("list", inner=Type("prim", "String"))
        return Type("list", inner=infer(items, key, in_list=True))
    if all(isinstance(s, bool) for s in samples):
        return Type("prim", "Boolean")
    if all(is_num(s) for s in samples):
        if any(isinstance(s, float) for s in samples):
            return Type("prim", "Double")
        return Type("prim", "Long" if any(abs(s) > 2**31 - 1 for s in samples) else "Int")
    if all(isinstance(s, str) for s in samples):
        return Type("prim", "String")
    WARNINGS.append(f"'{key}' has mixed types in the sample, defaulted to String")
    return Type("prim", "String")


def top_fields(sample):
    if isinstance(sample, list):
        sample = [s for s in sample if isinstance(s, dict)]
        if not sample:
            sys.exit("Sample JSON must be an object (or an array of objects).")
        WARNINGS.append("Top-level JSON is an array, used its element shape")
        return infer_fields(sample)
    if not isinstance(sample, dict):
        sys.exit("Sample JSON must be an object (or an array of objects).")
    return infer_fields([sample])


def collect(cls, seen=None):
    seen = seen if seen is not None else {}
    if cls.name in seen:
        if [f.key for f in seen[cls.name].fields] != [f.key for f in cls.fields]:
            WARNINGS.append(f"Nested class name '{cls.name}' is used by two different shapes")
        return []
    seen[cls.name] = cls
    out = [cls]
    for f in cls.fields:
        t = f.type
        while t.kind == "list":
            t = t.inner
        if t.kind == "obj":
            out += collect(t.cls, seen)
    return out


# ------------------------------------------------------------- rendering ----

def layer_name(n, layer):
    return {"response": f"Response{n}", "request": f"Request{n}", "entity": f"{n}Entity",
            "specEntity": f"{n}SpecEntity", "model": n, "spec": f"{n}Spec"}[layer]


def type_str(t, layer):
    if t.kind == "prim":
        return t.name
    if t.kind == "list":
        return f"List<{type_str(t.inner, layer)}>"
    return layer_name(t.cls.name, layer)


def default_value(t, cfg, imports, layer):
    if t.kind == "list":
        return "emptyList()"
    if t.kind == "obj":
        return f"{layer_name(t.cls.name, layer)}()"
    if t.name == "String":
        if "emptyString" in cfg["imports"]:
            imports.add(cfg["imports"]["emptyString"])
            return "emptyString()"
        return '""'
    return MODEL_DEFAULTS[t.name]


def to_entity(expr, t, top=True):
    """response -> entity (values pass through, nested objects/lists are mapped)."""
    sep = "?." if top else "."
    if t.kind == "prim":
        return expr
    if t.kind == "obj":
        return f"{expr}{sep}toEntity()"
    if t.inner.kind == "prim":
        return expr
    return f"{expr}{sep}map {{ {to_entity('it', t.inner, False)} }}"


def to_model(expr, t, cfg, imports, top=True):
    """entity -> model (nullable -> non-null with defaults)."""
    if t.kind == "prim":
        if not top:
            return expr
        if t.name == "String":
            return f"{expr}.orEmpty()"
        return f"{expr} ?: {default_value(t, cfg, imports, 'model')}"
    if t.kind == "obj":
        if not top:
            return f"{expr}.toModel()"
        return f"{expr}?.toModel() ?: {default_value(t, cfg, imports, 'model')}"
    if t.inner.kind == "prim":
        return f"{expr}.orEmpty()" if top else expr
    inner = to_model("it", t.inner, cfg, imports, False)
    return f"{expr}?.map {{ {inner} }}.orEmpty()" if top else f"{expr}.map {{ {inner} }}"


def req_from_entity(expr, t, top=True):
    """specEntity (nullable) -> request (nullable)."""
    if t.kind == "prim":
        return expr
    if t.kind == "obj":
        r = layer_name(t.cls.name, "request")
        return f"{expr}?.let {{ {r}.fromEntity(it) }}" if top else f"{r}.fromEntity({expr})"
    if t.inner.kind == "prim":
        return expr
    sep = "?." if top else "."
    return f"{expr}{sep}map {{ {req_from_entity('it', t.inner, False)} }}"


def spec_from_model(expr, t):
    """spec model (non-null) -> specEntity."""
    if t.kind == "prim":
        return expr
    if t.kind == "obj":
        return f"{layer_name(t.cls.name, 'specEntity')}.fromModel({expr})"
    if t.inner.kind == "prim":
        return expr
    return f"{expr}.map {{ {spec_from_model('it', t.inner)} }}"


def render_class(c, layer, cfg, imports, mappers=True):
    ser = SERIAL.get(cfg.get("serialization", "none"))
    cname = layer_name(c.name, layer)
    head, params = "", []

    for f in c.fields:
        nm = ident(f.name)
        if layer in DEFAULT_LAYERS:
            params.append(f"val {nm}: {type_str(f.type, layer)} = {default_value(f.type, cfg, imports, layer)}")
            continue
        ann = ""
        if layer in ("response", "request") and ser and f.key != f.name:
            ann = f"@{ser[1].format(k=f.key)} "
            imports.add(ser[0])
        params.append(f"{ann}val {nm}: {type_str(f.type, layer)}? = null")

    if layer in ("response", "request") and ser and ser[2]:
        imports.add(ser[2][0])
        head = f"@{ser[2][1]}\n"
    if layer in DEFAULT_LAYERS:
        head = "@Parcelize\n"
        imports.update({"kotlinx.parcelize.Parcelize", "android.os.Parcelable"})

    sig = f"{head}data class {cname}(\n" + ",\n".join(f"    {p}" for p in params) + "\n)"

    if layer in ("response", "entity"):
        iface, method = ("ToEntityMapper", "toEntity") if layer == "response" else ("ToModelMapper", "toModel")
        imports.add(cfg["imports"][iface])
        tgt = layer_name(c.name, NEXT_LAYER[layer])
        if layer == "response":
            conv = lambda f: to_entity(ident(f.name), f.type)
        else:
            conv = lambda f: to_model(ident(f.name), f.type, cfg, imports)
        args = ",\n".join(f"        {ident(f.name)} = {conv(f)}" for f in c.fields)
        return f"{sig} : {iface}<{tgt}> {{\n    override fun {method}() = {tgt}(\n{args}\n    )\n}}\n"

    if layer in ("request", "specEntity"):
        if layer == "request" and not mappers:
            return f"{sig}\n"
        if layer == "request":
            iface, meth, src = "FromEntityMapper", "fromEntity", layer_name(c.name, "specEntity")
            param = f"entity: {src}?"
            conv = lambda f: req_from_entity(f"entity?.{ident(f.name)}", f.type)
        else:
            iface, meth, src = "FromModelMapper", "fromModel", layer_name(c.name, "spec")
            param = f"model: {src}"
            conv = lambda f: spec_from_model(f"model.{ident(f.name)}", f.type)
        imports.add(cfg["imports"][iface])
        args = ",\n".join(f"            {ident(f.name)} = {conv(f)}" for f in c.fields)
        return (f"{sig} {{\n    companion object : {iface}<{src}, {cname}> {{\n"
                f"        override fun {meth}({param}) = {cname}(\n{args}\n        )\n    }}\n}}\n")

    return f"{sig} : Parcelable {{}}\n"          # model / spec


def package_of(dir_path):
    m = re.search(r"/(?:java|kotlin)/(.+)$", "/" + Path(dir_path).as_posix())
    if not m:
        sys.exit(f"Cannot derive package from '{dir_path}' (expected .../java/... or .../kotlin/...)")
    return m.group(1).replace("/", ".")


def render_file(layer, top, cfg, mappers=True):
    classes = collect(top)
    imports = set()
    bodies = [render_class(c, layer, cfg, imports, mappers) for c in classes]

    pkgs = {k: package_of(v) for k, v in cfg["paths"].items()}
    own = pkgs[PATH_KEY[layer]]
    nxt = NEXT_LAYER.get(layer)
    if nxt and not (layer == "request" and not mappers):
        imports.update(f"{pkgs[PATH_KEY[nxt]]}.{layer_name(c.name, nxt)}" for c in classes)
    imports = {i for i in imports if i.rsplit(".", 1)[0] != own}

    imp = "\n".join(f"import {i}" for i in sorted(imports))
    text = f"package {own}\n\n" + (imp + "\n\n" if imp else "") + "\n".join(bodies)
    return text, [layer_name(c.name, layer) for c in classes]


# ----------------------------------------------------- duplicate guard ------

DECL_RE = re.compile(
    r"^(?:(?:public|internal|private|protected|abstract|open|sealed|data|enum|annotation|inline|value|fun)\s+)*"
    r"(?:class|interface|object)\s+(\w+)", re.M)


def build_index(root):
    """top-level class/interface/object name -> files that declare it."""
    idx = {}
    for dp, dns, fns in os.walk(root):
        dns[:] = [d for d in dns if d not in SKIP_DIRS]
        for fn in fns:
            if fn.endswith(".kt"):
                p = Path(dp) / fn
                try:
                    text = p.read_text(errors="ignore")
                except OSError:
                    continue
                for m in DECL_RE.finditer(text):
                    idx.setdefault(m.group(1), []).append(p)
    return idx


# ------------------------------------------------------------------- io -----

TOOL_DIR = Path(__file__).resolve().parent

# Same content as the shipped response.json / request.json, used to detect "not edited yet".
DEFAULT_SAMPLES = {
    "response": {"user_id": "abc123", "title": "Sample title", "description": "Sample description"},
    "request": {"id": "abc123", "name": "Sample name"},
}


def ago(path):
    import time
    secs = int(time.time() - path.stat().st_mtime)
    for size, unit in ((86400, "day"), (3600, "hour"), (60, "minute")):
        if secs >= size:
            n = secs // size
            return f"{n} {unit}{'s' if n != 1 else ''} ago"
    return "just now"


def remind(label, arg, data):
    """Print which sample file is used, when it was last edited, and whether it is still the default."""
    p = Path(arg).expanduser()
    if not p.is_file():
        return False
    stale = data == DEFAULT_SAMPLES[label]
    print(f"  {label + '.json':<14} {p}  (edited {ago(p)})")
    if stale:
        print(f"  {'':<14} ! still the default sample. Edit it first:  nano {p}")
    return stale


def find_config(explicit):
    for c in (explicit, os.environ.get("DEV_TOOLS_CONFIG"), TOOL_DIR.parent / "config.json", TOOL_DIR / "config.json"):
        if c and Path(c).expanduser().is_file():
            return Path(c).expanduser()
    sys.exit("config.json not found. Expected at ../config.json (next to the tool folders), "
             "or pass --config / set DEV_TOOLS_CONFIG.")


def read_json(path):
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"{path}: invalid JSON (line {e.lineno}, column {e.colno}): {e.msg}")


def load_json(arg):
    p = Path(arg).expanduser()
    if p.is_file():
        return read_json(p)
    if arg.lstrip().startswith(("{", "[")):
        try:
            return json.loads(arg)
        except json.JSONDecodeError as e:
            sys.exit(f"Invalid inline JSON: {e.msg}")
    sys.exit(f"File not found: {p}")


def write_file(path, content, class_names, root, index, opts):
    shown = path.relative_to(root)
    if path.exists() and not opts.force:
        print(f"  SKIP (file exists)      {shown}")
        return
    clashes = {n: [p for p in index.get(n, []) if p != path] for n in class_names}
    clashes = {n: ps for n, ps in clashes.items() if ps}
    if clashes:
        n, ps = next(iter(clashes.items()))
        print(f"  SKIP (duplicate class)  {shown}: '{n}' is already declared in {ps[0].relative_to(root)}")
        return
    if opts.dry_run:
        print(f"  WOULD CREATE            {shown}\n" + "-" * 60 + f"\n{content}" + "-" * 60)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"  CREATED                 {shown}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("model", nargs="?", help="Model name in PascalCase, e.g. Testing")
    ap.add_argument("--response", default=str(TOOL_DIR / "response.json"),
                    help="Response sample: file path or inline JSON (default: response.json in the tool folder)")
    ap.add_argument("--with-request", action="store_true",
                    help="Also generate the request chain from request.json")
    ap.add_argument("--request", help="Request sample: file path or inline JSON (implies --with-request)")
    ap.add_argument("--no-from-mapper", action="store_true",
                    help="Request: generate only RequestX as a plain data class (no spec entity/model, no mappers)")
    ap.add_argument("--project", help="Android project root (overrides config / ANDROID_PROJECT_ROOT)")
    ap.add_argument("--config", help="Path to config.json (default: ../config.json)")
    ap.add_argument("--dry-run", action="store_true", help="Print the files instead of writing them")
    ap.add_argument("--force", action="store_true", help="Overwrite existing files")
    ap.add_argument("--yes", "-y", action="store_true", help="Skip the 'did you update the JSON files?' question")
    opts = ap.parse_args()

    cfg_path = find_config(opts.config)
    cfg = read_json(cfg_path)
    for k in ("response", "request", "entity", "model"):
        if k not in cfg.get("paths", {}):
            sys.exit(f"{cfg_path}: missing paths.{k}")

    root_str = opts.project or os.environ.get("ANDROID_PROJECT_ROOT") or cfg.get("projectRoot")
    root = Path(root_str or "").expanduser().resolve()
    if not root_str or not root.is_dir():
        sys.exit(f"Android project root not found: {root_str!r}\n"
                 f"Set projectRoot in {cfg_path} or pass --project /path/to/project")

    model = opts.model
    if not model:
        if not sys.stdin.isatty():
            ap.error("model name is required")
        model = input("Model name (e.g. Testing): ").strip()
    if not re.fullmatch(r"[A-Z][A-Za-z0-9]*", model):
        sys.exit("Model name must be PascalCase, e.g. Testing")

    response = load_json(opts.response)
    request = None
    if opts.request or opts.with_request:
        request = load_json(opts.request or str(TOOL_DIR / "request.json"))

    print("\nSample files used:")
    stale = remind("response", opts.response, response)
    if request is not None:
        stale = remind("request", opts.request or str(TOOL_DIR / "request.json"), request) or stale
    if sys.stdin.isatty() and not opts.yes and not opts.dry_run:
        msg = "Still the default sample, generate anyway?" if stale else "Are these up to date?"
        if input(f"\n{msg} [y/N]: ").strip().lower() != "y":
            sys.exit("Aborted. Edit the JSON file(s), then run again.")

    fields = top_fields(response)
    jobs = [("response", fields, True), ("entity", fields, True), ("model", fields, True)]
    if request is not None:
        rf = top_fields(request)
        if opts.no_from_mapper:
            jobs.append(("request", rf, False))
        else:
            jobs += [("request", rf, True), ("specEntity", rf, True), ("spec", rf, True)]

    index = build_index(root)
    print(f"\nProject: {root}\nModel:   {model}\n")
    for layer, flds, mappers in jobs:
        text, names = render_file(layer, ClassDef(model, flds), cfg, mappers)
        path = root / cfg["paths"][PATH_KEY[layer]] / f"{layer_name(model, layer)}.kt"
        write_file(path, text, names, root, index, opts)

    for w in dict.fromkeys(WARNINGS):
        print(f"  WARNING: {w}")


if __name__ == "__main__":
    main()
